# The Dice of Doom of (aux games dice-of-doom app), ready to play: it runs
# src/dice-of-doom-server.scm on the aux image, which has the modules installed and tested.
# .github/workflows/docker.publish.yml builds it right after that image and passes it as BASE,
# pinned by digest; `make docker-dice-of-doom` builds it on the published one.
#
#   docker run --rm -p 8080:8080 ghcr.io/massimo-nocentini/aux.scm/dice-of-doom:master
#
# then open http://HOST:8080/game.html from any machine that reaches HOST; `-p 9000:8080`
# publishes it on port 9000 instead. It is built for linux/amd64 and linux/arm64.

ARG BASE=ghcr.io/massimo-nocentini/aux.scm:master

FROM ${BASE}

COPY src/dice-of-doom-server.scm /opt/dice-of-doom/

WORKDIR /opt/dice-of-doom

ENV PORT=8080

EXPOSE 8080

# nobody: the server needs to read the script and the installed modules, nothing more.
USER 65534:65534

# Any page will do: a path other than game.html answers without dealing a game.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
	CMD curl -s -o /dev/null "http://127.0.0.1:${PORT}/health" || exit 1

CMD ["csi", "-s", "dice-of-doom-server.scm"]
