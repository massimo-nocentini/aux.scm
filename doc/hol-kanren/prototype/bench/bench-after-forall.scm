(import scheme (chicken base) (chicken time) srfi-1 (aux base) (aux stream) (aux kanren micro) (aux kanren lambda))
(define-relation (appendo r s rs)
  (cond° ((null° r) (=° s rs))
         ((fresh° (a d c) (cons° a d r) (cons° a c rs) (appendo d s c)))))
(define L (iota 1999))
(define pre (∀° (z) ✓°))
(define-dynamic-relation (typeof° m t)
  (cond°
    ((fresh° (M N B) (=° m `(app ,M ,N)) (typeof° M `(arr ,B ,t)) (typeof° N B)))
    ((fresh° (R A B) (=° m `(abs ,R)) (=° t `(arr ,A ,B))
       (∀° (x) (⊃° ((typeof° x A)) (typeof° (@ R x) B)))))))
(define pre-typeof (fresh° (T) (typeof° `(abs ,(ƛ (x) x)) T)))
(define (search g) (length (§->list ((fresh° (q) (g q)) μkanren-state-empty))))
(define (timeit label thunk)
  (let loop ((k 0) (best 1e9) (r #f))
    (if (= k 3) (begin (print label "\t" r "\t" best " ms"))
        (let* ((t0 (current-process-milliseconds)) (r (thunk)) (t1 (current-process-milliseconds)))
          (loop (add1 k) (min best (- t1 t0)) r)))))
(timeit "backwards-2000 search            " (λ () (search (λ (q) (fresh° (x y) (=° q (list x y)) (appendo x y L))))))
(timeit "backwards-2000 search, ∀° before " (λ () (search (λ (q) (fresh° (x y) pre (=° q (list x y)) (appendo x y L))))))
(timeit "backwards-2000 search, typeof° before" (λ () (search (λ (q) (fresh° (x y) pre-typeof (=° q (list x y)) (appendo x y L))))))
(timeit "open-1000 search                 " (λ () (length (§->list (take§ 1000 ((fresh° (q x y z) (appendo x y z) (=° q (list x y z))) μkanren-state-empty))))))
(timeit "open-1000 search, ∀° before      " (λ () (length (§->list (take§ 1000 ((fresh° (q x y z) pre (appendo x y z) (=° q (list x y z))) μkanren-state-empty))))))
