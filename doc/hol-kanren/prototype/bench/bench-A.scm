(import scheme (chicken base) (chicken time) (chicken process-context) srfi-1 (aux base) (aux stream) (aux kanren micro))
(cond-expand (with-lambda (import (aux kanren lambda))) (else))
(define-relation (appendo r s rs)
  (cond° ((null° r) (=° s rs))
         ((fresh° (a d c) (cons° a d r) (cons° a c rs) (appendo d s c)))))
(define L (iota 1999))
(define (search g) (length (§->list ((fresh° (q) (g q)) μkanren-state-empty))))
(define (timeit label thunk)
  (let loop ((k 0) (best 1e9) (r #f))
    (if (= k 3) (begin (print label "\t" r "\t" best " ms"))
        (let* ((t0 (current-process-milliseconds)) (r (thunk)) (t1 (current-process-milliseconds)))
          (loop (add1 k) (min best (- t1 t0)) r)))))
(timeit "backwards plain      " (λ () (search (λ (q) (fresh° (x y) (=° q (list x y)) (appendo x y L))))))
(timeit "backwards + symbol° t" (λ () (search (λ (q) (fresh° (x y t) (symbol° t) (=° q (list x y)) (appendo x y L))))))
(timeit "backwards + ≠° t 1   " (λ () (search (λ (q) (fresh° (x y t) (≠° t 1) (=° q (list x y)) (appendo x y L))))))
(timeit "backwards + absent° t" (λ () (search (λ (q) (fresh° (x y t) (absent° 'z t) (=° q (list x y)) (appendo x y L))))))
