(define-relation (appendo r s rs)
  (cond° ((null° r) (=° s rs))
         ((fresh° (a d c) (cons° a d r) (cons° a c rs) (appendo d s c)))))
(define-relation (membero x l) (fresh° (a d) (=° l (cons a d)) (or° (=° x a) (membero x d))))
(define (all-distinct° vs)
  (if (null? vs) ✓° (and° (fold (λ (w g) (and° g (≠° (car vs) w))) ✓° (cdr vs)) (all-distinct° (cdr vs)))))
(define L (iota 1999))
(define (search g) (length (§->list ((fresh° (q) (g q)) μkanren-state-empty))))
(define (timeit label thunk)
  (let loop ((k 0) (best 1e9) (r #f))
    (if (= k 3) (begin (print label "\t" r "\t" best " ms"))
        (let* ((t0 (current-process-milliseconds)) (r (thunk)) (t1 (current-process-milliseconds)))
          (loop (add1 k) (min best (- t1 t0)) r)))))
(timeit "backwards-2000 full " (λ () (length (°->list #f (fresh° (q x y) (=° q (list x y)) (appendo x y L))))))
(timeit "backwards-2000 search" (λ () (search (λ (q) (fresh° (x y) (=° q (list x y)) (appendo x y L))))))
