
((author "Massimo Nocentini")
 (synopsis "Auxiliary definitions and macros.")
 (license "MIT AND AGPL-3.0-only AND BSD-2-Clause AND GPL-2.0-only")
 (version "0.2.0")
 (test-dependencies srfi-18)
 (dependencies srfi-13 srfi-69 srfi-1 srfi-18 srfi-19 vector-lib sxml-transforms spiffy intarweb uri-common)
 (components
  (c-object chicken-timsort (source "chicken-timsort.c") (csc-options "-I/usr/local/include" "-C" "-DNDEBUG"))
  (c-object chicken-simdjson 
    (source "chicken-simdjson.cpp") 
    (csc-options "-I/usr/local/include" "-C" "-std=c++11" "-DNDEBUG") 
    (link-options "-L" "-lstdc++"))
    #;(c-object chicken-hwy
    (source "chicken-hwy.cpp")
    (csc-options "-I/usr/local/include")
    (link-options "-L" "-lhwy" "-L" "-lhwy_contrib"))
  (extension aux.sxml (component-dependencies aux.base))
  (extension aux.unittest)
  (extension aux.base)
  (extension aux.commons)
  (extension aux.tabling)
  (extension aux.variable)
  (extension aux.category.monad (modules (aux category monad) (aux category monad plus)))
  (extension aux.category.writer)
  (extension aux.category.identity (modules (aux category identity) (aux category monad identity)))
  (extension aux.category.list (modules (aux category list) (aux category monad list) (aux category monad plus list) (aux category writer list) (aux category monad writer list)))
  (extension aux.category.difflist (modules (aux category difflist) (aux category monad difflist) (aux category writer difflist) (aux category monad writer difflist)))
  (extension aux.category.ziplist (modules (aux category ziplist) (aux category monad ziplist)))
  (extension aux.category.reader (modules (aux category reader) (aux category monad reader)))
  (extension aux.category.state (modules (aux category state) (aux category monad state)))
  (extension aux.category.prob (modules (aux category prob) (aux category monad prob)))
  (extension aux.category.maybe (modules (aux category maybe) (aux category monad maybe)))
  (extension aux.libc)
  (extension aux.lua
    (modules (aux lua) (aux lua internal))
    (csc-options  "-I/usr/local/include")
	  (link-options "-L" "-llua" "-L" "-lm"))
  #;(extension aux.judy 
    (modules (aux judy) (aux judyL))
	  (csc-options  "-I/usr/local/include")
	  (link-options "-L" "-lJudy"))
  (extension aux.timsort (objects chicken-timsort) (csc-options  "-I/usr/local/include"))
  (extension aux.simdjson (objects chicken-simdjson) (csc-options  "-I/usr/local/include"))
  #;(extension aux.hwy (objects chicken-hwy) (csc-options  "-I/usr/local/include"))
  (extension aux.continuation (modules (aux continuation) (aux category continuation) (aux category monad continuation)))
  (extension aux.continuation.delimited (csc-options "-O2" "-d1" "-no-trace"))
  (extension aux.continuation.classic (modules (aux continuation classic) (aux continuation amb)))
  (extension aux.stream)
  (extension aux.stream.sicp)
  (extension aux.stream.series)
  (extension aux.fds.queue)
  (extension aux.fds.sbral)
  (extension aux.fds.unionfind)
  (extension aux.fds.heap)
  (extension aux.search (component-dependencies aux.base aux.stream.sicp aux.fds.queue aux.fds.heap))
  (extension aux.search.adversarial (component-dependencies aux.base aux.stream.sicp))
  (extension aux.schemer.seasoned)
  (extension aux.machine.env)
  (extension aux.machine.sc)
  (extension aux.machine.secd)
  (extension aux.nondeterministic)
  (extension aux.hakaru10.random (component-dependencies aux.base))
  (extension aux.hansei.pmap (component-dependencies aux.base))
  (extension aux.hansei.random (component-dependencies aux.base aux.hakaru10.random))
  (extension aux.hansei (component-dependencies aux.base aux.continuation.delimited aux.hansei.pmap aux.hansei.random aux.hakaru10.random))
  (extension aux.hansei.lazy (component-dependencies aux.base aux.hansei))
  (extension aux.hansei.parsec (component-dependencies aux.base aux.hansei))
  (extension aux.hakaru10.distribution (component-dependencies aux.base aux.hakaru10.random))
  (extension aux.hakaru10.util (component-dependencies aux.base aux.hakaru10.distribution))
  (extension aux.hakaru10.engine (component-dependencies aux.base aux.category.monad aux.category.state aux.hakaru10.random aux.hakaru10.distribution))
  (extension aux.hakaru10.exact (component-dependencies aux.base aux.hansei aux.hakaru10.random aux.hakaru10.distribution aux.hakaru10.util aux.hakaru10.engine))
  (extension aux.hakaru10 (component-dependencies aux.base aux.category.monad aux.category.state aux.stream aux.hakaru10.random aux.hakaru10.distribution aux.hakaru10.util aux.hakaru10.engine aux.hakaru10.exact))
  (extension aux.cml)
  (extension aux.kanren.micro)
  (extension aux.kanren.arith)
  (extension aux.kanren.date)
  (extension aux.kanren.micro.show)
  (extension aux.kanren.lambda (component-dependencies aux.base aux.stream aux.fds.sbral aux.kanren.micro aux.kanren.micro.show))
  (extension aux.kanren.unionfind (modules (aux kanren unionfind) (aux kanren unionfind reasoned)))
  (extension aux.pie.racket (component-dependencies aux.base))
  (extension aux.pie.fresh (component-dependencies aux.base aux.pie.racket))
  (extension aux.pie.syntax (component-dependencies aux.base aux.pie.racket))
  (extension aux.pie.locations (component-dependencies aux.base aux.pie.racket aux.pie.syntax))
  (extension aux.pie.syntax-parse (component-dependencies aux.base aux.pie.racket aux.pie.syntax))
  (extension aux.pie.basics (component-dependencies aux.base aux.pie.racket aux.pie.fresh aux.pie.locations))
  (extension aux.pie.alpha (component-dependencies aux.base aux.pie.basics))
  (extension aux.pie.normalize (component-dependencies aux.base aux.pie.racket aux.pie.basics aux.pie.locations))
  (extension aux.pie.resugar (component-dependencies aux.base aux.pie.racket aux.pie.basics))
  (extension aux.pie.parser (component-dependencies aux.base aux.pie.racket aux.pie.syntax aux.pie.syntax-parse aux.pie.locations aux.pie.basics))
  (extension aux.pie.typechecker (component-dependencies aux.base aux.pie.racket aux.pie.basics aux.pie.normalize aux.pie.alpha aux.pie.locations))
  (extension aux.pie.pretty (component-dependencies aux.base aux.pie.racket aux.pie.resugar))
  (extension aux.pie.serialization (component-dependencies aux.base aux.pie.basics aux.pie.normalize))
  (extension aux.pie.rep (component-dependencies aux.base aux.pie.basics aux.pie.normalize aux.pie.typechecker))
  (extension aux.pie.pie-err (component-dependencies aux.base aux.pie.racket aux.pie.locations aux.pie.pretty))
  (extension aux.pie.show-goal (component-dependencies aux.base aux.pie.racket aux.pie.resugar aux.pie.pretty))
  (extension aux.pie (component-dependencies aux.base aux.pie.racket aux.pie.syntax aux.pie.syntax-parse aux.pie.locations aux.pie.basics aux.pie.normalize aux.pie.typechecker aux.pie.rep aux.pie.parser aux.pie.serialization aux.pie.resugar aux.pie.pretty aux.pie.pie-err aux.pie.show-goal))
  (extension aux.j-bob.lang)
  (extension aux.j-bob (component-dependencies aux.j-bob.lang))
  (extension aux.j-bob.little-prover (component-dependencies aux.j-bob.lang aux.j-bob))
  (extension aux.games.dice-of-doom)
  (extension aux.land-of-lisp.webserver (component-dependencies aux.base))
  (extension aux.land-of-lisp.webserver.spiffy (component-dependencies aux.base))
  (extension aux.land-of-lisp.svg (component-dependencies aux.base))
  (extension aux.anthropic)
