(the Atom 'a)
(the (Vec Atom 2)
  (vec:: 'b
    (vec:: 'c vecnil)))
(the (Π ((E U)
         (n Nat))
      (→ (Vec E
            (add1 n))
        (Vec E n)))
  (λ (E n es)
    (tail es)))
(the (Π ((E U)
         (l Nat)
         (j Nat))
      (→ (Vec E l)
          (Vec E j)
        (Vec E
          (iter-Nat l
             (the Nat j)
             (λ (k)
               (add1 k))))))
  (λ (E l j es end)
    (ind-Vec l es
       (λ (k xs)
         (Vec E
           (iter-Nat k
              (the Nat j)
              (λ (k₁)
                (add1 k₁)))))
       end
       (λ (k h t ih)
         (vec:: h ih)))))
(the (Vec Atom 2)
  (vec:: 'a
    (vec:: 'b vecnil)))
(the (Π ((n Nat))
      (→ (Vec Nat n)
        Nat))
  (λ (n v)
    (ind-Vec n v
       (λ (k xs)
         Nat)
       0
       (λ (k h t ih)
         (add1 ih)))))
(the Atom 'x)
