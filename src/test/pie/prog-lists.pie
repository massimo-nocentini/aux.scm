#lang pie
(claim length (Π ((E U)) (-> (List E) Nat)))
(define length
  (λ (E es)
    (rec-List es 0 (λ (e es length-es) (add1 length-es)))))
(length Atom (:: 'a (:: 'b (:: 'c nil))))
(claim append (Π ((E U)) (-> (List E) (List E) (List E))))
(define append
  (λ (E start end)
    (rec-List start end (λ (e es ih) (:: e ih)))))
(append Atom (:: 'a nil) (:: 'b (:: 'c nil)))
append
(claim list->vec (Π ((E U) (es (List E))) (Vec E (length E es))))
(define list->vec
  (λ (E es)
    (ind-List es
      (λ (es) (Vec E (length E es)))
      vecnil
      (λ (e es ih) (vec:: e ih)))))
list->vec
(list->vec Atom (:: 'x (:: 'y nil)))
(the (List (List Nat)) (:: (:: 1 nil) (:: (:: 2 (:: 3 nil)) nil)))
(check-same (List Atom) (append Atom nil (:: 'a nil)) (:: 'a nil))
