(the (Π ((n Nat))
      (= Nat
        (add1 n)
        (add1 n)))
  (λ (n)
    (same (add1 n))))
(the (Π ((n Nat))
      (= Nat
        (iter-Nat n
           (the Nat 1)
           (λ (m)
             (add1 m)))
        (add1 n)))
  (λ (n)
    (ind-Nat n
       (λ (k)
         (= Nat
           (iter-Nat k
              (the Nat 1)
              (λ (m)
                (add1 m)))
           (add1 k)))
       (same 1)
       (λ (n-1 ih)
         (cong ih
           (λ (m)
             (add1 m)))))))
(the (Π ((a Nat)
         (b Nat))
      (→ (= Nat a b)
        (= Nat b a)))
  (λ (a b p)
    (symm p)))
(the (Π ((a Nat)
         (b Nat)
         (c Nat))
      (→ (= Nat a b)
          (= Nat b c)
        (= Nat a c)))
  (λ (a b c p q)
    (trans p q)))
(the (Π ((P (→ Nat
               U))
         (a Nat)
         (b Nat))
      (→ (= Nat a b)
          (P a)
        (P b)))
  (λ (P a b eq pa)
    (replace eq
      (λ (x)
        (P x))
      pa)))
(the (Π ((x Nat)
         (p (= Nat x x)))
      (= (= Nat x x)
        p
        p))
  (λ (x p)
    (same p)))
